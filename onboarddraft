            <button type="button" class="sig-clear" onclick="clearSig()">Clear</button>
          </div>

          <!-- Draw mode -->
          <div id="drawWrap">
            <div class="sig-canvas-wrap" id="canvasWrap">
              <canvas id="sigCanvas"></canvas>
              <div class="sig-placeholder" id="sigPlaceholder"><span>Draw your signature here</span></div>
            </div>
          </div>

          <!-- Type mode -->
          <div class="sig-type-wrap" id="typeWrap">
            <input type="text" class="sig-type-input" id="sigTypeInput" placeholder="Type your full name" oninput="renderTypedSig()">
