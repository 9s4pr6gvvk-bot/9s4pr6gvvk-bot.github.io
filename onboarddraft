<script>
// ── REFERENCE + DATE ──
(function(){
  var d=new Date();
  var ref='FM-'+(d.getFullYear())+('0'+(d.getMonth()+1)).slice(-2)+('0'+d.getDate()).slice(-2)+
          '-'+Math.floor(1000+Math.random()*9000);
  var fmt=d.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'});
  document.getElementById('docRef').textContent=ref;
  document.getElementById('docDate').textContent=fmt;
  document.getElementById('refField').value=ref;
  document.getElementById('dateField').value=fmt;
  document.getElementById('successRef').textContent=ref;
})();

// ── PACKAGE TOGGLE ──
document.getElementById('package').addEventListener('change',function(){
  var block=document.getElementById('priceBlock');
  block.style.display=this.value.includes('£35')?'flex':'none';
});

// ── AGREE ROW HIGHLIGHT ──
document.getElementById('agreeTerms').addEventListener('change',function(){
  document.getElementById('agreeRow').classList.toggle('checked',this.checked);
});

// ── SIGNATURE CANVAS ──
var canvas=document.getElementById('sigCanvas');
var ctx=canvas.getContext('2d');
var drawing=false;
var hasSig=false;
var mode='draw';

function resizeCanvas(){
  var wrap=document.getElementById('canvasWrap');
  var ratio=window.devicePixelRatio||1;
  var rect=wrap.getBoundingClientRect();
  canvas.width=rect.width*ratio;
  canvas.height=160*ratio;
  canvas.style.width=rect.width+'px';
  canvas.style.height='160px';
  ctx.scale(ratio,ratio);
  ctx.strokeStyle='#e8e4de';
  ctx.lineWidth=2;
  ctx.lineCap='round';
  ctx.lineJoin='round';
}
resizeCanvas();
window.addEventListener('resize',resizeCanvas);

function getPos(e){
  var rect=canvas.getBoundingClientRect();
  var ratio=window.devicePixelRatio||1;
  if(e.touches){
    return{x:e.touches[0].clientX-rect.left,y:e.touches[0].clientY-rect.top};
  }
  return{x:e.clientX-rect.left,y:e.clientY-rect.top};
}
canvas.addEventListener('mousedown',function(e){if(mode!='draw')return;drawing=true;var p=getPos(e);ctx.beginPath();ctx.moveTo(p.x,p.y);e.preventDefault();});
canvas.addEventListener('mousemove',function(e){if(!drawing||mode!='draw')return;var p=getPos(e);ctx.lineTo(p.x,p.y);ctx.stroke();hasSig=true;document.getElementById('sigPlaceholder').style.opacity='0';});
canvas.addEventListener('mouseup',function(){drawing=false;});
canvas.addEventListener('mouseleave',function(){drawing=false;});
canvas.addEventListener('touchstart',function(e){if(mode!='draw')return;drawing=true;var p=getPos(e);ctx.beginPath();ctx.moveTo(p.x,p.y);e.preventDefault();},{passive:false});
canvas.addEventListener('touchmove',function(e){if(!drawing||mode!='draw')return;var p=getPos(e);ctx.lineTo(p.x,p.y);ctx.stroke();hasSig=true;document.getElementById('sigPlaceholder').style.opacity='0';e.preventDefault();},{passive:false});
canvas.addEventListener('touchend',function(){drawing=false;});

function setMode(m){
  mode=m;
  document.getElementById('btnDraw').classList.toggle('active',m=='draw');
  document.getElementById('btnType').classList.toggle('active',m=='type');
  document.getElementById('drawWrap').style.display=m=='draw'?'block':'none';
  document.getElementById('typeWrap').style.display=m=='type'?'block':'none';
  if(m=='draw')resizeCanvas();
}

function renderTypedSig(){
  var txt=document.getElementById('sigTypeInput').value.trim();
  hasSig=txt.length>0;
}

function clearSig(){
  ctx.clearRect(0,0,canvas.width,canvas.height);
  hasSig=false;
  document.getElementById('sigPlaceholder').style.opacity='1';
  document.getElementById('sigTypeInput').value='';
}

function captureSig(){
  if(mode=='type'){
    var txt=document.getElementById('sigTypeInput').value.trim();
    if(!txt)return null;
    var c2=document.createElement('canvas');
    c2.width=700;c2.height=160;
    var cx=c2.getContext('2d');
    cx.fillStyle='#0d0d0d';
    cx.fillRect(0,0,700,160);
    cx.fillStyle='#e8e4de';
    cx.font='italic 68px "Brush Script MT", cursive';
    cx.textBaseline='middle';
    cx.fillText(txt,30,80);
    return c2.toDataURL('image/png');
  }
  if(!hasSig)return null;
  return canvas.toDataURL('image/png');
}

// ── VALIDATION ──
function required(id,errId){
  var el=document.getElementById(id);
  var ok=el.value.trim().length>0;
  el.classList.toggle('err',!ok);
  document.getElementById(errId).classList.toggle('show',!ok);
  return ok;
}
function validEmail(id,errId){
  var el=document.getElementById(id);
  var ok=/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value.trim());
  el.classList.toggle('err',!ok);
  document.getElementById(errId).classList.toggle('show',!ok);
  return ok;
}

// ── FORM SUBMIT ──
document.getElementById('onboardForm').addEventListener('submit',function(e){
  e.preventDefault();
  var ok=true;
  if(!required('clientName','errClientName'))ok=false;
  if(!required('businessName','errBusinessName'))ok=false;
  if(!validEmail('email','errEmail'))ok=false;
  if(!required('phone','errPhone'))ok=false;
  if(!required('trade','errTrade'))ok=false;
  if(!required('brief','errBrief'))ok=false;
  if(!required('package','errPackage'))ok=false;
  if(!required('sigName','errSigName'))ok=false;

  // terms
  var terms=document.getElementById('agreeTerms');
  var termsOk=terms.checked;
  document.getElementById('errTerms').classList.toggle('show',!termsOk);
  if(!termsOk)ok=false;

  // signature
  var sigImg=captureSig();
  if(!sigImg){
    document.getElementById('errSig').classList.add('show');
    ok=false;
  } else {
    document.getElementById('errSig').classList.remove('show');
    document.getElementById('sigData').value=sigImg;
  }

  if(!ok){
    var firstErr=document.querySelector('.err-msg.show');
    if(firstErr)firstErr.scrollIntoView({behavior:'smooth',block:'center'});
    return;
  }

  document.getElementById('replytoField').value=document.getElementById('email').value;

  var btn=document.getElementById('submitBtn');
  btn.disabled=true;
  btn.innerHTML='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation:spin 1s linear infinite;"><path d="M21 12a9 9 0 11-18 0"/></svg> Submitting...';

  // ── FORMSPREE ENDPOINT: replace the URL below with your Formspree endpoint ──
  fetch('https://formspree.io/f/YOUR_ENDPOINT_HERE', {
    method:'POST',
    headers:{'Accept':'application/json'},
    body:new FormData(document.getElementById('onboardForm'))
  })
  .then(function(r){
    if(r.ok){
      document.getElementById('formWrap').style.display='none';
      document.getElementById('successScreen').classList.add('show');
      window.scrollTo({top:0,behavior:'smooth'});
    } else {
      btn.disabled=false;
      btn.innerHTML='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 12l2 2 4-4m5.6-4.4A10 10 0 1118.3 20"/></svg> Try again';
      alert('Submission failed. Please try again or email info@franks-media.co.uk');
    }
  })
  .catch(function(){
    btn.disabled=false;
    btn.innerHTML='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 12l2 2 4-4m5.6-4.4A10 10 0 1118.3 20"/></svg> Try again';
    alert('Network error. Please check your connection and try again.');
  });
});

// spin keyframe
var style=document.createElement('style');
style.textContent='@keyframes spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}';
document.head.appendChild(style);
</script>
</body>
