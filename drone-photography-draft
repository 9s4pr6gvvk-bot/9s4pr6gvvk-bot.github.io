    <button class="cc-btn cc-decline" id="cookieDecline">Decline</button>
  </div>
</div>
<script>
(function(){
  var KEY="fm_cookie_consent";
  var banner=document.getElementById("cookieBanner");
  var acc=document.getElementById("cookieAccept");
  var dec=document.getElementById("cookieDecline");
  function stored(){try{return localStorage.getItem(KEY);}catch(e){return null;}}
  function save(v){try{localStorage.setItem(KEY,v);}catch(e){}}
  function hide(){banner.classList.remove("show");}
  function show(){banner.classList.add("show");}
  function accept(){save("accepted");hide();if(window.gtag){gtag("consent","update",{"analytics_storage":"granted"});}if(window.__loadGA){window.__loadGA();}}
  function decline(){save("declined");hide();}
  if(acc)acc.addEventListener("click",accept);
  if(dec)dec.addEventListener("click",decline);
  if(!stored()){setTimeout(show,700);}
})();
</script>
